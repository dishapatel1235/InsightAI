# ==========================================
# InsightAI Root .gitignore
# ==========================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Uploaded Files & Temporary Staging
backend/uploads/*
!backend/uploads/.gitkeep

# Environment Variables & Secrets
.env
.env.local
.env.*.local
backend/.env
frontend/analyst-project/.env
frontend/analyst-project/.env.local

# Node.js / Frontend Artifacts
node_modules/
frontend/analyst-project/node_modules/
frontend/analyst-project/dist/
frontend/analyst-project/dist-ssr/
frontend/analyst-project/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
